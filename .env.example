# ---------------------------------------------------------------------------
# BookMyProfile — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database.
# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Postgres) — also switch `provider` to "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/bookmyprofile?schema=public"

# Public base URL of the deployment. Used to build checkout return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Dodo Payments (https://app.dodopayments.com)
# ---------------------------------------------------------------------------
# API key from Developer -> API Keys.
DODO_PAYMENTS_API_KEY=""
# "test_mode" while developing, "live_mode" in production.
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Signing secret from Developer -> Webhooks -> <endpoint> -> Signing secret.
DODO_PAYMENTS_WEBHOOK_SECRET=""
# The Dodo product that campaign bookings are charged against. Create a
# "pay what you want" one-time product so per-booking amounts can be passed.
DODO_PAYMENTS_PRODUCT_ID=""

# ---------------------------------------------------------------------------
# Self-custodial crypto payments (USDC / USDT)
# ---------------------------------------------------------------------------
# Advertisers can pay stablecoins straight to a wallet YOU control; the server
# verifies each transfer on-chain (no third-party processor). Leave a chain's
# address blank to disable it. NEVER put a private key or seed phrase here —
# only public receiving addresses.
#
# Solana receiving address (base58). Receives both USDC and USDT.
CRYPTO_SOLANA_ADDRESS=""
# Ethereum/EVM receiving address (0x…). Reused across the EVM chains below.
CRYPTO_EVM_ADDRESS=""
# Which EVM networks to accept (comma-separated): ethereum,base,arbitrum.
# Base and Arbitrum have cent-level gas; Ethereum L1 can cost several dollars.
CRYPTO_EVM_CHAINS="base,arbitrum"
# Optional RPC overrides. Public endpoints are used when blank, but they
# rate-limit — set Helius / Alchemy / Infura URLs for production reliability.
CRYPTO_SOLANA_RPC_URL=""
CRYPTO_ETHEREUM_RPC_URL=""
CRYPTO_BASE_RPC_URL=""
CRYPTO_ARBITRUM_RPC_URL=""

# ---------------------------------------------------------------------------
# Creator admin console
# ---------------------------------------------------------------------------
# Long random string; grants access to /admin. Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN=""

# Slug of the creator featured on the marketing site.
NEXT_PUBLIC_PRIMARY_CREATOR_SLUG="shub0414"
