{
  "name": "bookmyprofile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:pricing": "node --experimental-strip-types --import ./scripts/alias-hooks.mjs scripts/verify-pricing.ts",
    "test:dates": "node --experimental-strip-types --import ./scripts/alias-hooks.mjs scripts/verify-dates.ts",
    "test:lifecycle": "node --experimental-strip-types --import ./scripts/alias-hooks.mjs scripts/verify-lifecycle.ts",
    "test": "npm run test:pricing && npm run test:dates && npm run test:lifecycle",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && prisma db seed"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dodopayments": "^2.51.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "standardwebhooks": "^1.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
